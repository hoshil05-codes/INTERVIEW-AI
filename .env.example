# ========================================================
# INTERVAI ENVIRONMENT CONFIGURATION
# ========================================================

# Gemini API Key (Required)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Optional, defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Port (Optional, cloud platforms like Render/Railway set this automatically)
PORT=5000

# ========================================================
# DATABASE SETTINGS (Optional - App uses resilient local storage if omitted)
# ========================================================
# Option A: Single Database URL (Recommended for Railway, Aiven, TiDB)
# DATABASE_URL=mysql://root:password@host:3306/intreviewapp

# Option B: Individual MySQL credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=intreviewapp
DB_PORT=3306
DB_SSL=false
